{
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/weeklyclaw-archive",
      "destination": "/episodes",
      "permanent": true
    },
    {
      "source": "/episodes/:episode/agenda",
      "destination": "/episodes?week=:episode&deck=main",
      "permanent": true
    },
    {
      "source": "/episodes/:episode/agenda.md",
      "destination": "/episodes?week=:episode&deck=main",
      "permanent": true
    }
  ]
}
