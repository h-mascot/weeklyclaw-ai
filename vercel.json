{
  "cleanUrls": true,
  "outputDirectory": ".",
  "redirects": [
    {
      "source": "/discord",
      "destination": "https://discord.gg/KtyabWNsq",
      "permanent": false
    },
    {
      "source": "/weeklyclaw-archive",
      "destination": "/episodes",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.weeklyclaw.ai"
        }
      ],
      "destination": "https://weeklyclaw.ai/:path*",
      "permanent": true
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "www.weeklyclaw.ai"
        }
      ],
      "destination": "https://weeklyclaw.ai/",
      "permanent": true
    }
  ]
}
